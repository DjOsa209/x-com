{
  "name": "x-ecommerce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "db:local": "node scripts/mysql-local.mjs",
    "db:docker": "docker compose up -d mysql",
    "test": "vitest run",
    "test:integration": "tsx scripts/integration.ts",
    "catalog:refresh": "tsx scripts/refresh-catalog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fal-ai/client": "^1.10.1",
    "@google/genai": "^2.30.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "lucide-react": "^1.59.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "stripe": "^23.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
