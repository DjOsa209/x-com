HOST=127.0.0.1
PORT=4317
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3308
MYSQL_USER=x_ecommerce
MYSQL_PASSWORD=replace-with-your-own-password
MYSQL_DATABASE=x_ecommerce
# Optional: set via Settings instead; secrets are encrypted at rest locally.
ECHOTIK_USERNAME=
ECHOTIK_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FAL_KEY=
KIE_API_KEY=
FAL_VIDEO_MODEL=fal-ai/kling-video/v3/standard/image-to-video
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_IMAGE_EDIT_MODEL=fal-ai/nano-banana-2/edit
FAL_ENHANCE_MODEL=fal-ai/topaz/upscale/video
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4317/api/tiktok/callback

# Authentication is required by default in production. This template also enables it in dev.
AUTH_REQUIRED=true
# Set true on the web process when running `npm run worker` separately.
WORKER_EXTERNAL=false
APP_PUBLIC_URL=http://localhost:4317
X_ALLOWED_HOSTS=localhost,127.0.0.1,::1,[::1]
# Stable 64-hex encryption key; otherwise .local/master.key is used.
# X_ENCRYPTION_KEY=

# Optional platform billing, never sent to browsers.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_PACKS_JSON=[]
# Additional raw fal model IDs, schemas must be reviewed before enabling.
FAL_EXTRA_MODELS_JSON=[]

# Optional object storage. Local uploads remain readable after switching.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Video orchestration defaults (also configurable in Settings).
VIDEO_DEFAULT_MODEL=kling-standard
VIDEO_SEGMENT_STRATEGY=balanced
VIDEO_SEGMENT_SECONDS=8
VIDEO_MAX_SEGMENTS=12
# VIDEO_MODELS_JSON=  # Prefer the validated model registry in Settings.
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe

# Local HTTP only: set false. Keep true behind HTTPS in production.
COOKIE_SECURE=false

# Optional explicit local subtitle font (Docker includes Noto CJK).
# SUBTITLE_FONT_FILE=/absolute/path/to/NotoSansCJK-Regular.ttc
# SUBTITLE_FONT_FAMILY=Noto Sans CJK SC
